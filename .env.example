# Copy to .env.local (for /app, local dev) and/or set as real secrets in
# Vercel (app) / GitHub Actions (pipeline). Never commit an actual .env file —
# see the "personal data stays in Supabase, not git" decision in the plan.

# --- Shared ---
SUPABASE_URL=

# --- /app (Vercel env vars — browser/session-scoped) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=

# --- /pipeline (GitHub Actions secrets — full-access, never exposed to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY_PIPELINE=
RESEND_API_KEY=
ALERT_EMAIL_TO=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
