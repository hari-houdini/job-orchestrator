# Copy to .env.local (for /app, local dev) and/or set as real secrets in
# Vercel (app) / GitHub Actions (pipeline). Never commit an actual .env file —
# see the "personal data stays in Supabase, not git" decision in the plan.
#
# Uses Supabase's current key system (publishable/secret), not the legacy
# JWT-based anon/service_role keys — those are being deprecated.
# See: https://supabase.com/docs/guides/getting-started/api-keys

# --- /app (Vercel env vars — browser/session-scoped, respects RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=

# --- /pipeline (GitHub Actions secrets — bypasses RLS, never exposed to the browser) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY_PIPELINE=
RESEND_API_KEY=
ALERT_EMAIL_TO=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
